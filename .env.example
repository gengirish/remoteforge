DATABASE_URL=
REDIS_URL=
NEXT_PUBLIC_APP_URL=https://remoteforge.intelliforge.tech
NEXT_PUBLIC_API_URL=https://remoteforge-api.fly.dev
API_URL=https://remoteforge-api.fly.dev
USD_TO_INR_RATE=84
# Ingested jobs are marked inactive once posted more than JOB_MAX_AGE_DAYS ago and unseen in their feed for JOB_STALE_DAYS
JOB_STALE_DAYS=3
JOB_MAX_AGE_DAYS=30

# Post-ingest enrichment (Frankfurter syncs daily; env is fallback only)
LOGO_DEV_TOKEN=
RAPIDAPI_KEY=
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_MONTHLY_QUOTA=200
JSEARCH_BATCH_SIZE=6

# Remote job affiliates (P1 = activate first)
AFFILIATE_TURING_REF=          # P1 — $150–$3,000/hire via turing.com/referrals
AFFILIATE_TOPTAL_REF=          # P1 — $2,000/client · $100/talent accepted
AFFILIATE_REMOTIVE_TAG=
AFFILIATE_REMOTE_PARTNER_CODE=
AFFILIATE_FLEXJOBS_ID=         # P2 — 15–30% recurring (ShareASale)
AFFILIATE_WWR_REF=             # INACTIVE — no public WWR/TopAccess affiliate program (Jun 2026)

# Payments — Dodo Payments (merchant of record: it is the seller, collects GST,
# and issues the invoice). Products are created in the Dodo dashboard and
# referenced here by id; prices live there, not in code.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=            # whsec_... from Developer > Webhooks
DODO_MODE=test                  # test | live — anything but "live" stays in test mode
DODO_PRODUCT_FEATURED=          # pdt_... featured job slot, INR 4,999/mo
DODO_PRODUCT_PREMIUM=           # pdt_... jobseeker premium, INR 499/mo (recurring)
DODO_PRODUCT_EMPLOYER_STARTER=  # pdt_... employer starter, INR 2,999/mo (recurring)

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Alerts
# AgentMail (https://docs.agentmail.to) — sends the weekly digest
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=alerts@intelliforge.tech
# Signs digest unsubscribe links (falls back to CRON_SECRET) and the base URL they point at
UNSUBSCRIBE_SECRET=
API_PUBLIC_URL=https://remoteforge-api.fly.dev
# WhatsApp via Sarvam; the sender exists in packages/job-alerts but the digest does not call it yet
SARVAM_API_KEY=

# Web cover-letter route (apps/web/app/api/cover-letter)
ANTHROPIC_API_KEY=

# Cron security
CRON_SECRET=

# Product integrations (ForgeAhead + Vettd)
REMOTEFORGE_INTERNAL_KEY=
ADMIN_SETTINGS_TOKEN=
NEXT_PUBLIC_FORGEAHEAD_URL=https://forgeahead.intelliforge.tech
NEXT_PUBLIC_VETTD_URL=https://www.vettd-app.com
INTELLIFORGE_CROSS_AUTH_SECRET=

# AI gig referral (used by db:seed for Outlier)
OUTLIER_REFERRAL_URL=
