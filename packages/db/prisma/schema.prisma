// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  company       String
  companyLogo   String?
  description   String
  tags          String[]
  salaryMin     Int?
  salaryMax     Int?
  currency      String    @default("USD")
  location      String    @default("Remote")
  category      String
  sourceBoard   String
  sourceId      String
  sourceUrl     String
  affiliateUrl  String?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  indiaFriendly     Boolean   @default(true)
  timezoneFriendly  Boolean?
  visaSponsorship   Boolean?
  postedAt      DateTime
  expiresAt     DateTime?
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clicks        JobClick[]
  featuredSlot  FeaturedSlot?
  savedBy       SavedJob[]
  applications  ApplicationRecord[]

  @@unique([sourceBoard, sourceId])
  @@index([category, isActive])
  @@index([postedAt(sort: Desc)])
  @@index([isFeatured, isActive])
  @@index([sourceBoard, isActive, lastSeenAt])
}

model JobClick {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ipHash      String?
  userAgent   String?
  referrer    String?
  converted   Boolean  @default(false)
  isBot       Boolean  @default(false)
  isDuplicate Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([createdAt(sort: Desc)])
  @@index([jobId, ipHash, createdAt])
}

model GigPlatform {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  logoUrl         String?
  description     String
  type            String
  specialties     String[]
  indiaAccepted   Boolean
  indiaPayNote    String?
  payMin          Int
  payMax          Int
  payNote         String?
  onboardingDays  String
  onboardingNote  String?
  referralUrl     String?
  affiliateUrl    String?
  referralReward  String?
  trustpilotScore Float?
  trustpilotCount Int?
  founded         Int?
  isActive        Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  clicks          GigClick[]
  earningsReports GigEarningsReport[]

  @@index([type, isActive])
  @@index([indiaAccepted, isActive])
}

model GigClick {
  id         String      @id @default(cuid())
  platformId String
  platform   GigPlatform @relation(fields: [platformId], references: [id])
  clickType  String
  utmSource  String?
  utmMedium  String?
  ipHash      String?
  userAgent   String?
  isBot       Boolean     @default(false)
  isDuplicate Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([platformId])
  @@index([createdAt(sort: Desc)])
  @@index([platformId, ipHash, createdAt])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  phone          String?
  jobCategories  String[]
  jobTags        String[]
  gigTypes       String[]
  wantsGigAlerts Boolean  @default(false)
  frequency      String   @default("weekly")
  source         String   @default("web")
  signals        String[]
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model FeaturedSlot {
  id          String   @id @default(cuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id])
  razorpayId  String?
  amountPaise Int
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model ProductSetting {
  key         String   @id
  value       String?
  label       String
  description String?
  group       String   @default("affiliate")
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model UserProfile {
  id              String              @id @default(cuid())
  clerkId         String              @unique
  email           String              @unique
  displayName     String?
  city            String?
  skills          String[]
  targetSalaryMin Int?
  targetSalaryMax Int?
  yearsExperience Int?
  resumeUrl       String?
  wantsRemote     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  savedJobs       SavedJob[]
  applications    ApplicationRecord[]
  // Phase 4 relations
  referralCode    ReferralCode?
  referrals       Referral[]     @relation("ReferrerReferrals")
  referredAs      Referral[]     @relation("RefereeReferral")
  wallet          ReferralWallet?
}

model SavedJob {
  id        String      @id @default(cuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])
  jobId     String
  job       Job         @relation(fields: [jobId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([userId, jobId])
}

model ApplicationRecord {
  id        String             @id @default(cuid())
  userId    String
  user      UserProfile        @relation(fields: [userId], references: [id])
  jobId     String
  job       Job                @relation(fields: [jobId], references: [id])
  company   String
  status    String             @default("applied")
  appliedAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  events    ApplicationEvent[]

  @@unique([userId, jobId])
}

model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   ApplicationRecord @relation(fields: [applicationId], references: [id])
  status        String
  note          String?
  daysFromApply Int?
  createdAt     DateTime          @default(now())
}

// Added by Phase 1 Agent B — also present in Phase 1 worktree (resolve on merge)
model CompanyProfile {
  id                 String   @id @default(cuid())
  name               String   @unique
  slug               String   @unique
  logoUrl            String?
  totalJobsPosted    Int      @default(0)
  indiaFriendlyCount Int      @default(0)
  indiaAcceptRate    Float?
  avgResponseDays    Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ExchangeRate {
  id        String   @id @default(cuid())
  pair      String   @unique
  rate      Float
  source    String
  fetchedAt DateTime @default(now())

  @@index([pair, fetchedAt(sort: Desc)])
}

model ApiQuotaUsage {
  id       String @id @default(cuid())
  provider String
  month    String
  used     Int    @default(0)
  limit    Int

  @@unique([provider, month])
  @@index([provider, month])
}

model SalaryReport {
  id          String   @id @default(cuid())
  role        String
  roleSlug    String
  company     String?
  yearsExp    Int
  salaryUsd   Int
  city        String?
  isVerified  Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@index([roleSlug])
  @@index([company])
}

model GigEarningsReport {
  id               String      @id @default(cuid())
  platformId       String
  platform         GigPlatform @relation(fields: [platformId], references: [id])
  taskType         String
  hoursPerWeek     Int
  earningsUsdMonth Int
  city             String?
  submittedAt      DateTime    @default(now())

  @@index([platformId])
}

// Phase 4 models
model ReferralCode {
  id          String      @id @default(cuid())
  userId      String      @unique
  user        UserProfile @relation(fields: [userId], references: [id])
  code        String      @unique
  clickCount  Int         @default(0)
  signupCount Int         @default(0)
  createdAt   DateTime    @default(now())
}

model Referral {
  id            String       @id @default(cuid())
  referrerId    String
  referrer      UserProfile  @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  code          String
  refereeUserId String?
  referee       UserProfile? @relation("RefereeReferral", fields: [refereeUserId], references: [id])
  status        String       @default("clicked")
  rewardPaise   Int          @default(50000)
  createdAt     DateTime     @default(now())
  convertedAt   DateTime?

  @@index([referrerId])
  @@index([code])
}

model ReferralWallet {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             UserProfile @relation(fields: [userId], references: [id])
  balancePaise     Int         @default(0)
  totalEarnedPaise Int         @default(0)
  updatedAt        DateTime    @updatedAt
}

model SuccessStory {
  id           String   @id @default(cuid())
  userId       String?
  displayName  String
  role         String
  company      String
  salaryUsd    Int?
  city         String?
  story        String
  appliedCount Int?
  isPublic     Boolean  @default(true)
  isApproved   Boolean  @default(false)
  submittedAt  DateTime @default(now())

  @@index([isPublic, isApproved])
}

// Phase 5 models
model EmployerProfile {
  id               String                @id @default(cuid())
  clerkId          String                @unique
  email            String                @unique
  companyName      String
  companySlug      String                @unique
  website          String?
  description      String?
  logoUrl          String?
  indiaBadge       Boolean               @default(false)
  subscriptionTier String                @default("free")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  jobs             DirectJobPosting[]
  subscription     EmployerSubscription?
}

model DirectJobPosting {
  id            String          @id @default(cuid())
  employerId    String
  employer      EmployerProfile @relation(fields: [employerId], references: [id])
  title         String
  description   String
  tags          String[]
  salaryMin     Int?
  salaryMax     Int?
  currency      String          @default("USD")
  indiaFriendly Boolean         @default(true)
  isActive      Boolean         @default(true)
  postedAt      DateTime        @default(now())
  expiresAt     DateTime?
  slug          String          @unique
  applyUrl      String?

  @@index([employerId, isActive])
  @@index([isActive, postedAt(sort: Desc)])
}

model EmployerSubscription {
  id         String          @id @default(cuid())
  employerId String          @unique
  employer   EmployerProfile @relation(fields: [employerId], references: [id])
  razorpayId String?
  amountPaise Int
  tier       String          @default("starter")
  startsAt   DateTime
  expiresAt  DateTime
  createdAt  DateTime        @default(now())
}

model PremiumSubscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  clerkId     String   @unique
  razorpayId  String?
  amountPaise Int      @default(49900)
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model ApiKey {
  id         String        @id @default(cuid())
  name       String
  keyHash    String        @unique
  keyPrefix  String
  userId     String?
  email      String
  tier       String        @default("free")
  callsLimit Int           @default(1000)
  createdAt  DateTime      @default(now())
  revokedAt  DateTime?
  usage      ApiKeyUsage[]
}

model ApiKeyUsage {
  id        String   @id @default(cuid())
  keyId     String
  key       ApiKey   @relation(fields: [keyId], references: [id])
  endpoint  String
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
}
