// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  company       String
  companyLogo   String?
  description   String
  tags          String[]
  salaryMin     Int?
  salaryMax     Int?
  currency      String    @default("USD")
  location      String    @default("Remote")
  category      String
  sourceBoard   String
  sourceId      String
  sourceUrl     String
  affiliateUrl  String?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  indiaFriendly Boolean   @default(true)
  postedAt      DateTime
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clicks        JobClick[]
  featuredSlot  FeaturedSlot?

  @@unique([sourceBoard, sourceId])
  @@index([category, isActive])
  @@index([postedAt(sort: Desc)])
  @@index([isFeatured, isActive])
}

model JobClick {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ipHash      String?
  userAgent   String?
  referrer    String?
  converted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([createdAt(sort: Desc)])
}

model GigPlatform {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  logoUrl         String?
  description     String
  type            String
  specialties     String[]
  indiaAccepted   Boolean
  indiaPayNote    String?
  payMin          Int
  payMax          Int
  payNote         String?
  onboardingDays  String
  onboardingNote  String?
  referralUrl     String?
  affiliateUrl    String?
  referralReward  String?
  trustpilotScore Float?
  trustpilotCount Int?
  founded         Int?
  isActive        Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  clicks          GigClick[]
  earningsReports GigEarningsReport[]

  @@index([type, isActive])
  @@index([indiaAccepted, isActive])
}

model GigClick {
  id         String      @id @default(cuid())
  platformId String
  platform   GigPlatform @relation(fields: [platformId], references: [id])
  clickType  String
  utmSource  String?
  utmMedium  String?
  ipHash     String?
  createdAt  DateTime    @default(now())

  @@index([platformId])
  @@index([createdAt(sort: Desc)])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  phone          String?
  jobCategories  String[]
  jobTags        String[]
  gigTypes       String[]
  wantsGigAlerts Boolean  @default(false)
  frequency      String   @default("weekly")
  source         String   @default("web")
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model FeaturedSlot {
  id          String   @id @default(cuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id])
  razorpayId  String?
  amountPaise Int
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model ProductSetting {
  key         String   @id
  value       String?
  label       String
  description String?
  group       String   @default("affiliate")
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// Phase 2 models (added by Phase 2 Agent A — duplicated here for Phase 4 relation integrity; resolve on merge)
model UserProfile {
  id              String    @id @default(cuid())
  clerkId         String    @unique
  email           String    @unique
  displayName     String?
  city            String?
  skills          String[]
  targetSalaryMin Int?
  targetSalaryMax Int?
  yearsExperience Int?
  resumeUrl       String?
  wantsRemote     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  savedJobs       SavedJob[]
  applications    ApplicationRecord[]
  // Phase 4 relations
  referralCode    ReferralCode?
  referrals       Referral[]     @relation("ReferrerReferrals")
  referredAs      Referral[]     @relation("RefereeReferral")
  wallet          ReferralWallet?
}

model SavedJob {
  id        String      @id @default(cuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])
  jobId     String
  createdAt DateTime    @default(now())

  @@unique([userId, jobId])
}

model ApplicationRecord {
  id        String      @id @default(cuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])
  jobId     String
  company   String
  status    String      @default("applied")
  appliedAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  events    ApplicationEvent[]

  @@unique([userId, jobId])
}

model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   ApplicationRecord @relation(fields: [applicationId], references: [id])
  status        String
  note          String?
  daysFromApply Int?
  createdAt     DateTime          @default(now())
}

// Phase 3 models (added by Phase 3 Agent A — duplicated here for completeness; resolve on merge)
model CompanyProfile {
  id                 String   @id @default(cuid())
  name               String   @unique
  slug               String   @unique
  totalJobsPosted    Int      @default(0)
  indiaFriendlyCount Int      @default(0)
  indiaAcceptRate    Float?
  avgResponseDays    Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SalaryReport {
  id          String   @id @default(cuid())
  role        String
  roleSlug    String
  company     String?
  yearsExp    Int
  salaryUsd   Int
  city        String?
  isVerified  Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@index([roleSlug])
  @@index([company])
}

model GigEarningsReport {
  id               String      @id @default(cuid())
  platformId       String
  platform         GigPlatform @relation(fields: [platformId], references: [id])
  taskType         String
  hoursPerWeek     Int
  earningsUsdMonth Int
  city             String?
  submittedAt      DateTime    @default(now())

  @@index([platformId])
}

// Phase 4 models
model ReferralCode {
  id          String      @id @default(cuid())
  userId      String      @unique
  user        UserProfile @relation(fields: [userId], references: [id])
  code        String      @unique
  clickCount  Int         @default(0)
  signupCount Int         @default(0)
  createdAt   DateTime    @default(now())
}

model Referral {
  id            String       @id @default(cuid())
  referrerId    String
  referrer      UserProfile  @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  code          String
  refereeUserId String?
  referee       UserProfile? @relation("RefereeReferral", fields: [refereeUserId], references: [id])
  status        String       @default("clicked")
  rewardPaise   Int          @default(50000)
  createdAt     DateTime     @default(now())
  convertedAt   DateTime?

  @@index([referrerId])
  @@index([code])
}

model ReferralWallet {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             UserProfile @relation(fields: [userId], references: [id])
  balancePaise     Int         @default(0)
  totalEarnedPaise Int         @default(0)
  updatedAt        DateTime    @updatedAt
}

model SuccessStory {
  id           String   @id @default(cuid())
  userId       String?
  displayName  String
  role         String
  company      String
  salaryUsd    Int?
  city         String?
  story        String
  appliedCount Int?
  isPublic     Boolean  @default(true)
  isApproved   Boolean  @default(false)
  submittedAt  DateTime @default(now())

  @@index([isPublic, isApproved])
}
