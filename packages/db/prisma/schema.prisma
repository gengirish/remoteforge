// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  company       String
  companyLogo   String?
  description   String
  tags          String[]
  salaryMin     Int?
  salaryMax     Int?
  currency      String    @default("USD")
  location      String    @default("Remote")
  category      String
  sourceBoard   String
  sourceId      String
  sourceUrl     String
  affiliateUrl  String?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  indiaFriendly Boolean   @default(true)
  postedAt      DateTime
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clicks        JobClick[]
  featuredSlot  FeaturedSlot?

  @@unique([sourceBoard, sourceId])
  @@index([category, isActive])
  @@index([postedAt(sort: Desc)])
  @@index([isFeatured, isActive])
}

model JobClick {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ipHash      String?
  userAgent   String?
  referrer    String?
  converted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([createdAt(sort: Desc)])
}

model GigPlatform {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  logoUrl         String?
  description     String
  type            String
  specialties     String[]
  indiaAccepted   Boolean
  indiaPayNote    String?
  payMin          Int
  payMax          Int
  payNote         String?
  onboardingDays  String
  onboardingNote  String?
  referralUrl     String?
  affiliateUrl    String?
  referralReward  String?
  trustpilotScore Float?
  trustpilotCount Int?
  founded         Int?
  isActive        Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  clicks          GigClick[]

  @@index([type, isActive])
  @@index([indiaAccepted, isActive])
}

model GigClick {
  id         String      @id @default(cuid())
  platformId String
  platform   GigPlatform @relation(fields: [platformId], references: [id])
  clickType  String
  utmSource  String?
  utmMedium  String?
  ipHash     String?
  createdAt  DateTime    @default(now())

  @@index([platformId])
  @@index([createdAt(sort: Desc)])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  phone          String?
  jobCategories  String[]
  jobTags        String[]
  gigTypes       String[]
  wantsGigAlerts Boolean  @default(false)
  frequency      String   @default("weekly")
  source         String   @default("web")
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model FeaturedSlot {
  id          String   @id @default(cuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id])
  razorpayId  String?
  amountPaise Int
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model ProductSetting {
  key         String   @id
  value       String?
  label       String
  description String?
  group       String   @default("affiliate")
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model EmployerProfile {
  id               String                @id @default(cuid())
  clerkId          String                @unique
  email            String                @unique
  companyName      String
  companySlug      String                @unique
  website          String?
  description      String?
  logoUrl          String?
  indiaBadge       Boolean               @default(false)
  subscriptionTier String                @default("free")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  jobs             DirectJobPosting[]
  subscription     EmployerSubscription?
}

model DirectJobPosting {
  id            String          @id @default(cuid())
  employerId    String
  employer      EmployerProfile @relation(fields: [employerId], references: [id])
  title         String
  description   String
  tags          String[]
  salaryMin     Int?
  salaryMax     Int?
  currency      String          @default("USD")
  indiaFriendly Boolean         @default(true)
  isActive      Boolean         @default(true)
  postedAt      DateTime        @default(now())
  expiresAt     DateTime?
  slug          String          @unique
  applyUrl      String?

  @@index([employerId, isActive])
  @@index([isActive, postedAt(sort: Desc)])
}

model EmployerSubscription {
  id         String          @id @default(cuid())
  employerId String          @unique
  employer   EmployerProfile @relation(fields: [employerId], references: [id])
  razorpayId String?
  amountPaise Int
  tier       String          @default("starter")
  startsAt   DateTime
  expiresAt  DateTime
  createdAt  DateTime        @default(now())
}

model PremiumSubscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  clerkId     String   @unique
  razorpayId  String?
  amountPaise Int      @default(49900)
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model ApiKey {
  id         String        @id @default(cuid())
  name       String
  keyHash    String        @unique
  keyPrefix  String
  userId     String?
  email      String
  tier       String        @default("free")
  callsLimit Int           @default(1000)
  createdAt  DateTime      @default(now())
  revokedAt  DateTime?
  usage      ApiKeyUsage[]
}

model ApiKeyUsage {
  id        String   @id @default(cuid())
  keyId     String
  key       ApiKey   @relation(fields: [keyId], references: [id])
  endpoint  String
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
}
