PORT=8080
DATABASE_URL=
CRON_SECRET=
CORS_ORIGINS=http://localhost:3000,https://remoteforge.intelliforge.tech
REMOTEFORGE_INTERNAL_KEY=
# Verifies the Clerk session token the web sends as Authorization: Bearer; unset = every user route is anonymous
CLERK_SECRET_KEY=
ADMIN_SETTINGS_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# AgentMail (https://docs.agentmail.to) — sends the weekly digest
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=alerts@intelliforge.tech
# Signs digest unsubscribe links (falls back to CRON_SECRET; rotating it invalidates sent links)
UNSUBSCRIBE_SECRET=
# Public base URL unsubscribe links point at
API_PUBLIC_URL=https://remoteforge-api.fly.dev
# Base URL for referral share links and email links
NEXT_PUBLIC_APP_URL=https://remoteforge.intelliforge.tech
# Leave unset: when set, ingest queues to BullMQ for a worker that isn't deployed
REDIS_URL=
# Ingested jobs are marked inactive once posted more than JOB_MAX_AGE_DAYS ago and unseen in their feed for JOB_STALE_DAYS
JOB_STALE_DAYS=3
JOB_MAX_AGE_DAYS=30
# Optional post-ingest enrichment (logos, JSearch salary backfill)
LOGO_DEV_TOKEN=
RAPIDAPI_KEY=
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_MONTHLY_QUOTA=200
JSEARCH_BATCH_SIZE=6
