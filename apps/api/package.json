{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:@prisma/client --external:bullmq --external:@x402/fetch",
    "start": "node dist/server.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.18.1",
    "@hono/node-server": "^1.13.7",
    "@intelliforge/api-core": "workspace:*",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.71.0",
    "hono": "^4.6.12",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
